						<li><asp:HyperLink ID="bedTransferOrReleseHyperLink" NavigateUrl="UI/BedTransferOrReleseForm.aspx" runat="server"><i class="fa fa-caret-right" aria-hidden="true"></i>&nbsp;&nbsp;Bed Transfer & Relese</asp:HyperLink></li>
