<body>
	<form runat="server">
		<asp:ScriptManager runat="server">
			<Scripts>
				<asp:ScriptReference Path="~/js/jquery-1.11.1.min.js"/>
				<asp:ScriptReference Path="~/js/bootstrap.min.js"/>
				<asp:ScriptReference Path="~/js/bootstrap-datepicker.js"/>
			</Scripts>
		</asp:ScriptManager>

		<nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
			<div class="container-fluid">
				<div class="navbar-header">
					<button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#sidebar-collapse">
						<span class="sr-only">Toggle navigation</span>
						<span class="icon-bar"></span>
						<span class="icon-bar"></span>
						<span class="icon-bar"></span>
					</button>
					<a class="navbar-brand" href="#"><span><img src="image/AmarHospitalLogo.jpg" class="logoImage" style="height: 30px; width: 30px" />  Amar Haspatal </span>& Diagnostic Center</a>
                        
					<ul class="user-menu">
						<li class="dropdown pull-right">
							<a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-user-o" aria-hidden="true"></i>&nbsp;&nbsp;User <span class="caret"></span></a>
							<ul class="dropdown-menu" role="menu">
								<li><asp:LinkButton ID="profileLinkButton" CssClass="btn btn-default" runat="server"><i class="fa fa-user" aria-hidden="true"></i>&nbsp;&nbsp;&nbsp;Profile</asp:LinkButton></li>
								<li><asp:LinkButton ID="settingLinkButton" CssClass="btn btn-default" runat="server"><i class="fa fa-cog" aria-hidden="true"></i>&nbsp;&nbsp;&nbsp;Setting</asp:LinkButton></li>
								<li><asp:LinkButton ID="logoutLinkButton" CssClass="btn btn-default" runat="server" OnClick="logoutLinkButton_Click"><i class="fa fa-sign-out" aria-hidden="true"></i>&nbsp;&nbsp;&nbsp;Logout</asp:LinkButton></li>
							</ul>
						</li>
					</ul>
				</div>
			</div>
			<!-- /.container-fluid -->
		</nav>

